# Copy to .env and fill in. Never commit .env.

# A random string; paste the same value into the extension's Settings.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
HIREPILOT_TOKEN=

PORT=8787

# Any OpenAI-compatible chat-completions endpoint works. Pick one block.

# Google Gemini (has a free tier):
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=

# OpenAI:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=

# Anthropic (OpenAI-compatibility endpoint):
# LLM_BASE_URL=https://api.anthropic.com/v1
# LLM_MODEL=claude-haiku-5-5
# LLM_API_KEY=

# Groq / OpenRouter / local Ollama (free, no key needed for Ollama):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# LLM_API_KEY=ollama

# Where your profile database and resumes are stored (relative to server/)
# DATA_DIR=data
